# Python
.venv/
__pycache__/
*.pyc
*.tmp

# ZCode / 工作流本机产物（全局 ignore 已盖，这里兜底别的机器）
.zcode/

# 模型权重（大文件，首次运行由 run.sh 自动下载）
skills/*/models/

# yaya-diarize 单独使用时的缓存目录（流水线内已被 out/ 白名单兜住）
**/.*.diar/

# 音频/视频（大文件，不进 git；原始文件自己保管）
*.m4a
*.mp3
*.wav
*.aac
*.flac
*.ogg
*.opus
*.mp4
*.mov
*.mkv
*.webm
*.part

# 产物/音频归档/缓存：数据默认在 skill 自己的 out/ 下（YAYA_HOME 可搬），
# 整目录不进 git——里面是私人 Space 笔记和音频
skills/*/out/

# 系统
.DS_Store

# 密钥（绝不能提交）
.env
*.key

# 本机浏览器调试产物（MCP 截图/日志），不进仓库
.playwright-mcp/

# serena MCP 工具自动生成的本机项目配置，不进仓库
.serena/
